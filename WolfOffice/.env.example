# Wolf Office Supabase project (see supabase/README.md). Required: every worker and the
# office server stop at startup without these two.
OFFICE_SUPABASE_URL=
OFFICE_SERVICE_KEY=

# Optional overrides, for reference only. The code reads these from the PROCESS environment
# (shell, or EnvironmentVariables in a plist), NOT from this file. Defaults shown.
# GROW_DIR=~/Grow/GrowSales                 # where the GrowSales repo lives (leaddesk, slots)
# GROW_APP_URL=https://growsales.vercel.app # dashboard the pay auditor opens
# GROW_ACCESS_CODE=                         # corporate access code for payaudit (else read from ~/Grow/RepText/.env)
# GROW_PYTHON=python3                       # python used by the lead desk and Runner (alias: LEADDESK_PYTHON)
# LEADDESK_FORMATS=state/leaddesk-formats.json
# CLAUDE_BIN=claude                         # Claude Code CLI the lead desk uses to name columns
# OFFICE_PORT=8787                          # office web UI port

.vercel
.env*
node_modules
.DS_Store
.env.local
public/

# SalesRabbit Time Track exports (imported via scripts/import-timetrack.mjs)
Time?Track*.pdf
*Time*Track*.csv
SR_TimeTrack*
.amplify-profile
.amplify-profile-*
amplify-*-probe.json

# SalesRabbit browser session + the API token it mints (never commit)
.sr-profile/
.amplify-profile*/
data/sr-auth.json

# Hub (hub.realtimeresults.com) login profiles — hold live bearer tokens.
# Glob, not the bare name: ISPs with their own Opendoor account get their own
# profile dir (.rtr-profile-omni/ etc), and those must never be committable either.
.rtr-profile*/

# ---------------------------------------------------------------------------
# Added when the repo was made portable (new-laptop safety pass).
# Rule of thumb: source and config in, secrets / data dumps / backups out.
# ---------------------------------------------------------------------------

# Editor backups of the app. There are a dozen of these; the history is in git.
index.html.bak*
index.html.backup-*
index.html.orig
index.html.pre-*
*.bak-[0-9]*
team-current.json.bak-*

# Working data: exports, imports and scratch. Regenerated by the syncs, and some
# of it is customer PII that must never leave the machine.
imports/
backups/
bria/
*.csv
*.xlsx
*.jsonl
__pycache__/
scripts/__pycache__/

# data/ is DENY-BY-DEFAULT. It mixes harmless config with live bearer tokens
# (sr-auth.json, salesrabbit-lead-endpoint.json), API probe dumps and rep PII.
# Only files verified free of credentials are allowlisted back in below — add to
# the allowlist only after checking the file yourself.
# data/* not data/ — git will not descend into an excluded DIRECTORY, so the
# negations below would never be reached with a bare "data/".
data/*
!data/isps.json
!data/rtr-sources.json
!data/amplify-sources.json
!data/terros-reps.json
!data/sr-lookups.json

# Local dev-server config, per machine.
.claude/launch.json

# write key for the sector_maps table (scripts/sector-maps.py)
data/.sector-map-key
.env.install-slots
.slots-profile-*/

# Every per-source SalesRabbit browser profile (.sr-profile-tds/ etc) holds a
# live login session. The bare `.sr-profile/` rule above missed the suffixed ones.
.sr-profile*/
.grow-*-profile/
*.bak-*
*.bak

# Names-only template for the successor; holds no values.
!.env.example

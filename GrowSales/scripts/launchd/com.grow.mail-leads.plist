<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Pulls lead spreadsheets Daxton/Nick asked you to import out of Gmail and
  drops them in imports/isp/. Every 10 min. Read-only IMAP: nothing is sent,
  deleted, or marked read.

  It only saves the file. com.grow.isp-intake then archives it to Drive and
  parks it; nothing imports until you run the isp-leads skill and name a rep.

  Needs GMAIL_USER + GMAIL_APP_PASSWORD in GrowSales/.env.prod.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.grow.mail-leads</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Frameworks/Python.framework/Versions/3.10/bin/python3</string>
    <string>/Users/joshuawolfer/Grow/GrowSales/scripts/mail-leads-pull.py</string>
    <string>--days</string>
    <string>3</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/joshuawolfer/Grow/GrowSales</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/Library/Frameworks/Python.framework/Versions/3.10/bin:/usr/bin:/bin:/usr/local/bin</string></dict>
  <key>StartInterval</key>
  <integer>600</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/joshuawolfer/Grow/GrowSales/imports/done/mail-leads.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/joshuawolfer/Grow/GrowSales/imports/done/mail-leads.log</string>
</dict>
</plist>

# Names only. Real values live in the password manager (see HANDOFF.md).
# Copy to the file named in each section and fill in. Every .env* except this
# one is gitignored.
#
# The api/ functions do NOT read these files. Their values live in the Vercel
# project's Environment Variables; `vercel env ls` shows the names.

# ---- .env.local  (scripts/*: grow-sync, import scripts, probes) -------------
SUPABASE_URL=https://cmkfohwbejcztctrpdnt.supabase.co
SUPABASE_SERVICE_KEY=
SALESRABBIT_API_KEY=
SR_ACCOUNT_KEY=
SR_SALESRABBIT_KEY=

# ---- .env.prod  (mail-leads-pull.py, sector-maps.py read GMAIL_* from here) --
# The mailbox ISP lead emails arrive in, with a Google App Password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
SYNC_TRIGGER_KEY=

# ---- .env.bria  (scripts/bria-schema-check.mjs) -----------------------------
BRIA_SUPABASE_URL=https://oofisagqyhfcpmfmcjwt.supabase.co
BRIA_SUPABASE_PUBLISHABLE_KEY=
BRIA_SUPABASE_READONLY_KEY=

# ---- .env.install-slots  (scripts/install-slots.mjs, Surf earliest-install walker)
SURF_USER_ID=
SURF_PIN=

# ---- outside the repo --------------------------------------------------------
# ~/.geocodio.env        GEOCODIO_API_KEY=      (scripts/geocode-file.mjs)
# ~/.terros.env          TERROS_API_KEY=        (scripts/push-to-terros.mjs)
# ~/Grow/RepText/.env    GROW_ACCESS_CODE=      (a corporate dashboard access code;
#                                                daily-report-text.mjs, WolfOffice payaudit)
# ~/Grow/TrainingVideos/.env  PEXELS_API_KEY= GEMINI_API_KEY= GEMINI_IMAGE_MODEL=
# data/.sector-map-key   write key for the sector_maps table (scripts/sector-maps.py)
# data/.sequifi-token    Sequifi API bearer (sequifi-roster-check skill)
#
# Token files written by a signed-in browser, never typed by hand:
# data/sr-auth.json      node scripts/grow-sync.mjs --seed
# data/sr-auth-tds.json  TDS SalesRabbit (capi v1), see docs/knowledge/data-sources.md
